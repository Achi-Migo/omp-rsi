{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "packages/dwfx-core/src/**/*.ts",
    ".omp/hooks/**/*.ts",
    ".omp/tools/**/*.ts",
    "assets/omp-host.d.ts"
  ]
}
